#!/usr/bin/env python3
"""Launcher: run from anywhere, e.g.  tools/opp-ping/opp-ping ping 11.0.0.1"""
import os
import sys

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from opp_ping.cli import main  # noqa: E402

# The guard matters: `demo` starts worker processes, and with the "spawn" or
# "forkserver" start method (the default on Linux since Python 3.14) each worker
# re-imports this file. Without the guard every worker would rerun the demo.
if __name__ == "__main__":
    sys.exit(main())
